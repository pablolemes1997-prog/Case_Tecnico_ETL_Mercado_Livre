# ===== Credenciais (NUNCA versionar o arquivo .env real) =====
ML_APP_ID=
ML_CLIENT_SECRET=
ML_CODE=                 # code de autorização (uso único); usado só na 1ª execução
ML_REDIRECT_URI=         # opcional; deve ser igual ao cadastrado na aplicação
ML_ACCESS_TOKEN=         # preenchido automaticamente
ML_REFRESH_TOKEN=        # preenchido automaticamente

# ===== API =====
ML_URL=https://api.mercadolibre.com
ML_URL_AUTORIZACAO=https://auth.mercadolibre.com.ar/authorization
ML_AUTH=oauth/token
ML_SITE_ID=MLA
ML_TIMEOUT=15

# ===== Endpoints =====
ML_PRODUCTS=products
ML_SEARCH=search
ML_ITEMS=items
ML_CURRENCIES=currencies
ML_CURRENCY=currency_conversions

# ===== Busca e ETL =====
ML_SEARCH_QUERY=Samsung Galaxy S24
ML_SEARCH_DOMAIN=MLA-CELLPHONES
ML_SEARCH_PAGE_SIZE=50
ML_LIMITE_REGISTROS=0
ML_MOEDA_DESTINO=USD

# ===== Banco (nome do arquivo, dentro de "[006] - Banco de Dados") =====
ML_DATABASE=mercado_livre.db
